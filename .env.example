# Supabase Backend Configuration
# Replace these with your actual Supabase project URL and anon public API key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Application Configuration
APP_NAME=School Manager
APP_ENV=production

# Master Administrative Security Key (Case-Sensitive, required for Staff & Teacher registration)
MASTER_KEY=YourPassword
